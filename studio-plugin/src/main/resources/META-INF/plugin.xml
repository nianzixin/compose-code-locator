<idea-plugin>
    <id>io.github.nianzixin.compose-code-locator</id>
    <name>Compose Code Locator</name>
    <version>0.1.6.3</version>
    <vendor url="https://github.com/nianzixin/compose-code-locator">nianzixin</vendor>
    <idea-version since-build="241" until-build="263.*" />

    <!-- 插件图标（Settings | Plugins 列表与 Marketplace 中显示） -->
    <icon>icons/pluginIcon.svg</icon>

    <description><![CDATA[
        Compose Code Locator provides Android Studio screenshot-to-source navigation for Jetpack Compose debug builds.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <!-- 项目打开时释放 Gradle 侧 bootstrap 环境（marker/jar/init script），实现 build.gradle 零配置 -->
    <applicationListeners>
        <listener
            class="dev.codelocator.studio.intellij.LocatorProjectOpenListener"
            topic="com.intellij.openapi.project.ProjectManagerListener" />
    </applicationListeners>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
            id="Compose Code Locator"
            factoryClass="dev.codelocator.studio.intellij.ComposeLocatorToolWindowFactory"
            icon="icons/toolWindowIcon.svg"
            anchor="right" />
    </extensions>

    <actions>
        <action
            id="dev.codelocator.studio.CaptureAndLocate"
            class="dev.codelocator.studio.intellij.CaptureAndLocateAnAction"
            text="Compose Code Locator"
            description="Open the Compose Code Locator tool window" />
    </actions>
</idea-plugin>
